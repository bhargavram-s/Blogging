pipeline {

    agent any

    tools {
        maven 'MAVEN 3.9.12'
    }

    stages {

        stage('Git Clone') {
            steps {
                git branch: 'main',
                    changelog: false,
                    poll: false,
                    url: 'https://github.com/bhargavram-s/Blogging.git'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Trivy Filesystem Scan') {
            steps {
                sh '''
                    export TMPDIR=/opt/trivy-tmp
                    trivy fs --format table -o fs.html .
                '''
            }
        }

        stage('Sonar Scan') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar
                    '''
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                configFileProvider([
                    configFile(
                        fileId: 'maven-settings',
                        variable: 'MAVEN_SETTINGS'
                    )
                ]) {
                    sh '''
                        mvn deploy -s "$MAVEN_SETTINGS"
                    '''
                }
            }
        }

        stage('Docker Build & Tag') {
            steps {
                sh '''
                    docker build \
                    -t bhargavram2309/blogging:${BUILD_NUMBER} .
                '''
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    export TMPDIR=/opt/trivy-tmp

                    trivy image \
                    --format table \
                    -o trivy-report.txt \
                    bhargavram2309/blogging:${BUILD_NUMBER}
                '''
            }
        }

        stage('Docker Push') {
            steps {
                sh '''
                    docker push bhargavram2309/blogging:${BUILD_NUMBER}
                '''
            }
        }

        stage('Kubernetes Deployment') {
            steps {
                sh '''
                    gcloud container clusters get-credentials blog-gke-cluster \
                        --zone us-central1-a \
                        --project project-8e71b0da-6039-4dfb-8b7

                    sed "s|bhargavram2309/blogging:BUILD_NUMBER|bhargavram2309/blogging:${BUILD_NUMBER}|g" \
                        deployment.yml > deployment-temp.yml

                    kubectl apply -f deployment-temp.yml
                '''
            }
        }
    }

    post {

        success {
            emailext(
                to: 'bhargavram824@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h3>Build Successful</h3>

                    <p><b>Job:</b> ${env.JOB_NAME}</p>
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>

                    <p>
                        <b>Docker Image:</b>
                        bhargavram2309/blogging:${env.BUILD_NUMBER}
                    </p>

                    <p>
                        <a href="${env.BUILD_URL}console">
                            View Jenkins Console Log
                        </a>
                    </p>

                    <p>Application deployed successfully to GKE.</p>
                """
            )
        }

        failure {
            emailext(
                to: 'bhargavram824@gmail.com',
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                mimeType: 'text/html',
                body: """
                    <h3>Build Failed</h3>

                    <p><b>Job:</b> ${env.JOB_NAME}</p>
                    <p><b>Build Number:</b> ${env.BUILD_NUMBER}</p>

                    <p>
                        <a href="${env.BUILD_URL}console">
                            View Jenkins Console Log
                        </a>
                    </p>

                    <p>
                        Build or deployment failed.
                        Please check the Jenkins console logs.
                    </p>
                """
            )
        }
    }
}
